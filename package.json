{
  "name": "solarsync",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @solarsync/api run dev",
    "dev:web": "npm --workspace @solarsync/web run dev",
    "build:api": "npm --workspace @solarsync/api run build",
    "build:web": "npm --workspace @solarsync/web run build"
  }
}